---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components'
---

<Layout title="Kaltwasser Kommunikation | Redesign Concept">
    <!-- Hero Section -->
    <header
        class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 px-6 overflow-hidden"
    >
        <!-- Background Elements -->
        <div
            class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-l from-blue-50 to-transparent -z-10"
        ></div>
        <div
            class="absolute top-20 right-20 w-64 h-64 bg-blue-100 rounded-full blur-3xl opacity-50 -z-10 animate-pulse"
        ></div>

        <div
            class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-12 items-center"
        >
            <div class="space-y-8">
                <div
                    class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-brand-blue text-xs font-semibold uppercase tracking-wider"
                >
                    <span
                        class="w-2 h-2 rounded-full bg-brand-blue animate-ping"
                    ></span>
                    Seit 1990
                </div>
                <h1
                    class="text-5xl lg:text-7xl font-bold leading-[1.1] text-brand-dark tracking-tight"
                >
                    Kommunikation,<br />
                    <span class="text-brand-blue serif italic pr-2"
                        >die bewegt.</span
                    >
                </h1>
                <p class="text-lg text-gray-600 max-w-xl leading-relaxed">
                    Wir gestalten Wandel. Von strategischer PR über
                    Bürgerdialog bis zur Krisenkommunikation. Aus Nürnberg,
                    München und Berlin für ganz Deutschland.
                </p>

                <div class="flex flex-col sm:flex-row gap-4 pt-4">
                    <a
                        href="#projekte"
                        class="inline-flex justify-center items-center px-8 py-4 bg-brand-blue text-white rounded-full font-medium hover:bg-blue-700 transition-all hover:shadow-lg hover:shadow-blue-200 group"
                    >
                        Unsere Cases
                        <Icon name="lucide:arrow-right" class="ml-2 w-4 h-4 group-hover:translate-x-1 transition-transform" />
                    </a>
                    <a
                        href="#kompetenzen"
                        class="inline-flex justify-center items-center px-8 py-4 bg-white border border-gray-200 text-gray-700 rounded-full font-medium hover:bg-gray-50 transition-colors"
                    >
                        Leistungen ansehen
                    </a>
                </div>
            </div>

            <!-- Abstract Visual / Stats -->
            <div class="relative hidden lg:block h-[500px]">
                <div
                    class="absolute right-0 top-10 w-[400px] h-[500px] bg-slate-200 rounded-2xl overflow-hidden shadow-2xl rotate-3 hover:rotate-0 transition-all duration-700"
                >
                    <img
                        src="https://images.unsplash.com/photo-1557804506-669a67965ba0?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80"
                        alt="Team collaboration"
                        class="w-full h-full object-cover opacity-90"
                    />
                    <div
                        class="absolute inset-0 bg-gradient-to-t from-brand-dark/80 to-transparent"
                    ></div>
                    <div class="absolute bottom-8 left-8 text-white">
                        <p
                            class="text-sm font-medium opacity-80 uppercase tracking-widest mb-1"
                        >
                            Aktuelles Projekt
                        </p>
                        <h3 class="text-2xl font-serif">
                            Wärmewende kommunizieren
                        </h3>
                        <p class="text-sm opacity-80 mt-2">
                            Strategie & Bürgerdialog
                        </p>
                    </div>
                </div>
                <!-- Floating Stat Card -->
                <div
                    class="absolute bottom-20 left-10 bg-white p-6 rounded-xl shadow-xl max-w-[200px] animate-bounce-slow"
                >
                    <div class="flex items-center gap-3 mb-2">
                        <div
                            class="p-2 bg-green-100 rounded-lg text-green-600"
                        >
                           <Icon name="lucide:trending-up" class="w-5 h-5" />
                        </div>
                        <span class="text-3xl font-bold text-gray-900"
                            >35+</span
                        >
                    </div>
                    <p class="text-sm text-gray-600 font-medium">
                        Jahre Erfahrung im Markt
                    </p>
                </div>
            </div>
        </div>
    </header>

    <!-- Logo Marquee Section -->
    <section
        class="py-12 bg-white border-b border-gray-100 overflow-hidden"
    >
        <div class="max-w-7xl mx-auto px-6 mb-8 text-center">
            <p
                class="text-xs font-bold text-gray-400 uppercase tracking-[0.2em]"
            >
                Vertrauen von führenden Unternehmen & Institutionen
            </p>
        </div>

        <!-- Infinite Scroll Container -->
        <div
            class="relative flex overflow-x-hidden group mask-linear-gradient"
        >
            <div
                class="animate-scroll flex items-center gap-16 whitespace-nowrap px-8"
            >
                <!-- Logos -->
                <img
                    src="/img/AEG-Logo.svg"
                    class="h-32 w-auto opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300 cursor-pointer"
                    alt="AEG Logo"
                />
                <img
                    src="/img/bayernkreativ-Logo.svg"
                    class="h-32 w-auto opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300 cursor-pointer"
                    alt="Bayern Kreativ Logo"
                />
                <img
                    src="/img/Bayernland-Logo.svg"
                    class="h-32 w-auto opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300 cursor-pointer"
                    alt="Bayernland Logo"
                />
                <img
                    src="/img/BFW-Nuernberg-Logo.svg"
                    class="h-32 w-auto opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300 cursor-pointer"
                    alt="BFW Nuernberg Logo"
                />
                <img
                    src="/img/bmfsfj-Logo.svg"
                    class="h-32 w-auto opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300 cursor-pointer"
                    alt="BMFSFJ Logo"
                />
                <img
                    src="/img/bmwi-Logo.svg"
                    class="h-32 w-auto opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300 cursor-pointer"
                    alt="BMWI Logo"
                />
                <img
                    src="/img/Bosch-Logo.svg"
                    class="h-32 w-auto opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300 cursor-pointer"
                    alt="Bosch Logo"
                />
                <img
                    src="/img/HP-Logo.svg"
                    class="h-32 w-auto opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300 cursor-pointer"
                    alt="HP Logo"
                />
                <img
                    src="/img/Intel-Logo.svg"
                    class="h-32 w-auto opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300 cursor-pointer"
                    alt="Intel Logo"
                />
                <img
                    src="/img/Kyocera-Logo.svg"
                    class="h-32 w-auto opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300 cursor-pointer"
                    alt="Kyocera Logo"
                />
                <img
                    src="/img/Nokia-Logo.svg"
                    class="h-32 w-auto opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300 cursor-pointer"
                    alt="Nokia Logo"
                />
                <img
                    src="/img/Philips-Logo.svg"
                    class="h-32 w-auto opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300 cursor-pointer"
                    alt="Philips Logo"
                />
                <img
                    src="/img/Samsung-Logo.svg"
                    class="h-32 w-auto opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300 cursor-pointer"
                    alt="Samsung Logo"
                />

                <!-- Duplicate for infinite loop -->
                <img
                    src="/img/AEG-Logo.svg"
                    class="h-32 w-auto opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300 cursor-pointer"
                    alt="AEG Logo"
                />
                <img
                    src="/img/bayernkreativ-Logo.svg"
                    class="h-32 w-auto opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300 cursor-pointer"
                    alt="Bayern Kreativ Logo"
                />
                <img
                    src="/img/Bayernland-Logo.svg"
                    class="h-32 w-auto opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300 cursor-pointer"
                    alt="Bayernland Logo"
                />
                <img
                    src="/img/BFW-Nuernberg-Logo.svg"
                    class="h-32 w-auto opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300 cursor-pointer"
                    alt="BFW Nuernberg Logo"
                />
                <img
                    src="/img/bmfsfj-Logo.svg"
                    class="h-32 w-auto opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300 cursor-pointer"
                    alt="BMFSFJ Logo"
                />
                <img
                    src="/img/bmwi-Logo.svg"
                    class="h-32 w-auto opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300 cursor-pointer"
                    alt="BMWI Logo"
                />
                <img
                    src="/img/Bosch-Logo.svg"
                    class="h-32 w-auto opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300 cursor-pointer"
                    alt="Bosch Logo"
                />
                <img
                    src="/img/HP-Logo.svg"
                    class="h-32 w-auto opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300 cursor-pointer"
                    alt="HP Logo"
                />
                <img
                    src="/img/Intel-Logo.svg"
                    class="h-32 w-auto opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300 cursor-pointer"
                    alt="Intel Logo"
                />
                <img
                    src="/img/Kyocera-Logo.svg"
                    class="h-32 w-auto opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300 cursor-pointer"
                    alt="Kyocera Logo"
                />
                <img
                    src="/img/Nokia-Logo.svg"
                    class="h-32 w-auto opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300 cursor-pointer"
                    alt="Nokia Logo"
                />
                <img
                    src="/img/Philips-Logo.svg"
                    class="h-32 w-auto opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300 cursor-pointer"
                    alt="Philips Logo"
                />
                <img
                    src="/img/Samsung-Logo.svg"
                    class="h-32 w-auto opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300 cursor-pointer"
                    alt="Samsung Logo"
                />
            </div>

            <!-- Fade edges overlay for smooth look -->
            <div
                class="pointer-events-none absolute inset-y-0 left-0 w-24 bg-gradient-to-r from-white to-transparent z-10"
            ></div>
            <div
                class="pointer-events-none absolute inset-y-0 right-0 w-24 bg-gradient-to-l from-white to-transparent z-10"
            ></div>
        </div>
    </section>

    <!-- Services Bento Grid -->
    <section id="kompetenzen" class="py-24 px-6 bg-white">
        <div class="max-w-7xl mx-auto">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <h2
                    class="text-3xl lg:text-4xl font-bold text-brand-dark mb-4"
                >
                    Kompetenz im Quadrat
                </h2>
                <p class="text-gray-600 text-lg">
                    Unser integrierter Ansatz verbindet klassische PR mit
                    modernen Dialogformaten.
                </p>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6 auto-rows-[250px]"
            >
                <!-- Main Service Card (Large) -->
                <div
                    class="bento-card md:col-span-2 md:row-span-2 bg-slate-900 rounded-3xl p-10 relative overflow-hidden group cursor-pointer"
                >
                    <div
                        class="absolute top-0 right-0 p-10 opacity-10 group-hover:opacity-20 transition-opacity"
                    >
                        <Icon name="lucide:users" class="w-48 h-48 text-white" />
                    </div>
                    <div
                        class="relative z-10 h-full flex flex-col justify-between"
                    >
                        <div>
                            <div
                                class="w-12 h-12 bg-blue-600 rounded-xl flex items-center justify-center mb-6"
                            >
                                <Icon name="lucide:message-circle" class="text-white w-6 h-6" />
                            </div>
                            <h3 class="text-3xl font-bold text-white mb-4">
                                Bürgerkommunikation
                            </h3>
                            <p
                                class="text-gray-400 text-lg leading-relaxed"
                            >
                                Akzeptanz schaffen durch Dialog. Wir
                                begleiten Infrastrukturprojekte, Bauvorhaben
                                und die Energiewende mit transparenter
                                Kommunikation auf Augenhöhe.
                            </p>
                        </div>
                        <span
                            class="text-blue-400 font-medium flex items-center gap-2 group-hover:translate-x-2 transition-transform"
                        >
                            Mehr erfahren
                            <Icon name="lucide:arrow-right" class="w-4 h-4" />
                        </span>
                    </div>
                </div>

                <!-- Service 2 -->
                <div
                    class="bento-card bg-blue-50 rounded-3xl p-8 flex flex-col justify-between group hover:bg-blue-100 cursor-pointer"
                >
                    <div
                        class="w-10 h-10 bg-white rounded-full flex items-center justify-center shadow-sm text-brand-blue mb-4"
                    >
                        <Icon name="lucide:building-2" class="w-5 h-5" />
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-gray-900 mb-2">
                            Corporate Comms
                        </h3>
                        <p class="text-sm text-gray-600">
                            Reputation stärken, intern wie extern.
                        </p>
                    </div>
                </div>

                <!-- Service 3 -->
                <div
                    class="bento-card bg-slate-50 rounded-3xl p-8 flex flex-col justify-between group hover:bg-slate-100 cursor-pointer"
                >
                    <div
                        class="w-10 h-10 bg-white rounded-full flex items-center justify-center shadow-sm text-brand-blue mb-4"
                    >
                        <Icon name="lucide:shield-alert" class="w-5 h-5" />
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-gray-900 mb-2">
                            Krisen-PR
                        </h3>
                        <p class="text-sm text-gray-600">
                            Sicher navigieren, wenn es stürmt. 24/7 Support.
                        </p>
                    </div>
                </div>

                <!-- Service 4 -->
                <div
                    class="bento-card md:col-span-2 bg-gradient-to-br from-brand-blue to-blue-600 rounded-3xl p-8 relative overflow-hidden group cursor-pointer"
                >
                    <div
                        class="absolute -right-10 -bottom-10 opacity-20 rotate-12"
                    >
                         <Icon name="lucide:share-2" class="w-40 h-40 text-white" />
                    </div>
                    <div
                        class="relative z-10 flex flex-col h-full justify-between"
                    >
                         <div
                            class="w-10 h-10 bg-white/20 backdrop-blur-md rounded-full flex items-center justify-center text-white mb-4"
                        >
                            <Icon name="lucide:smartphone" class="w-5 h-5" />
                        </div>
                        <div>
                            <h3 class="text-2xl font-bold text-white mb-2">
                                Social Media & Digital
                            </h3>
                            <p class="text-blue-100 max-w-sm">
                                Strategisches Storytelling für LinkedIn,
                                Instagram & Co. Vom Content-Plan bis zum
                                Community Management.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Service 5 -->
                <div
                    class="bento-card bg-slate-50 rounded-3xl p-8 flex flex-col justify-between group hover:bg-slate-100 cursor-pointer"
                >
                    <div
                        class="w-10 h-10 bg-white rounded-full flex items-center justify-center shadow-sm text-brand-blue mb-4"
                    >
                        <Icon name="lucide:megaphone" class="w-5 h-5" />
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-gray-900 mb-2">
                            Public Affairs
                        </h3>
                        <p class="text-sm text-gray-600">
                            Brücken bauen zwischen Wirtschaft und Politik.
                        </p>
                    </div>
                </div>
                 <!-- Service 6 -->
                 <div
                    class="bento-card bg-slate-50 rounded-3xl p-8 flex flex-col justify-between group hover:bg-slate-100 cursor-pointer"
                >
                    <div
                        class="w-10 h-10 bg-white rounded-full flex items-center justify-center shadow-sm text-brand-blue mb-4"
                    >
                        <Icon name="lucide:refresh-cw" class="w-5 h-5" />
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-gray-900 mb-2">
                            Change
                        </h3>
                        <p class="text-sm text-gray-600">
                            Veränderungsprozesse kommunikativ begleiten.
                        </p>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- Featured Projects (Horizontal Scroll Concept) -->
    <section id="projekte" class="py-24 bg-slate-50 overflow-hidden">
        <div
            class="max-w-7xl mx-auto px-6 mb-12 flex items-end justify-between"
        >
            <div>
                <span
                    class="text-brand-blue font-semibold uppercase tracking-wider text-sm"
                    >Case Studies</span
                >
                <h2 class="text-4xl font-bold text-brand-dark mt-2">
                    Aktuelle Arbeiten
                </h2>
            </div>
            <div class="hidden md:flex gap-2">
                <button
                    class="w-12 h-12 rounded-full border border-gray-300 flex items-center justify-center hover:bg-white hover:shadow-md transition-all"><Icon name="lucide:arrow-left" class="w-5 h-5" /></button>
                <button
                    class="w-12 h-12 rounded-full border border-gray-800 bg-brand-dark text-white flex items-center justify-center hover:bg-gray-700 transition-all"><Icon name="lucide:arrow-right" class="w-5 h-5" /></button>
            </div>
        </div>

        <div
            class="flex overflow-x-auto gap-8 px-6 pb-12 snap-x max-w-7xl mx-auto scrollbar-hide"
        >

            <!-- Project 1 -->
            <div class="min-w-[85vw] md:min-w-[500px] snap-center">
                <div
                    class="group relative rounded-2xl overflow-hidden aspect-[4/3] mb-6"
                >
                    <img
                        src="https://images.unsplash.com/photo-1473341304170-971dccb5ac1e?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80"
                        alt="Energy Grid"
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                    <div
                        class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-colors"
                    ></div>
                    <div
                        class="absolute top-4 left-4 bg-white/90 backdrop-blur px-3 py-1 rounded text-xs font-bold uppercase tracking-wide"
                    >
                        50Hertz
                    </div>
                </div>
                <h3
                    class="text-2xl font-bold text-brand-dark mb-2 group-hover:text-brand-blue transition-colors"
                >
                    Klarheit im Netzausbau
                </h3>
                <p class="text-gray-600 line-clamp-2">
                    Strategische Beratung und Konfliktmoderation für den
                    Übertragungsnetzbetreiber. Transparenz schafft
                    Akzeptanz.
                </p>
            </div>

            <!-- Project 2 -->
            <div class="min-w-[85vw] md:min-w-[500px] snap-center">
                <div
                    class="group relative rounded-2xl overflow-hidden aspect-[4/3] mb-6"
                >
                    <img
                        src="https://images.unsplash.com/photo-1542601906990-b4d3fb7d5c73?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80"
                        alt="Environment"
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                    <div
                        class="absolute top-4 left-4 bg-white/90 backdrop-blur px-3 py-1 rounded text-xs font-bold uppercase tracking-wide"
                    >
                        UmweltBank
                    </div>
                </div>
                <h3
                    class="text-2xl font-bold text-brand-dark mb-2 group-hover:text-brand-blue transition-colors"
                >
                    Ein Holzhochhaus als PR-Leuchtturm
                </h3>
                <p class="text-gray-600 line-clamp-2">
                    Bundesweite Medienpräsenz für den nachhaltigen
                    Firmensitz. Storytelling, das die Marke stärkt.
                </p>
            </div>

            <!-- Project 3 -->
            <div class="min-w-[85vw] md:min-w-[500px] snap-center">
                <div
                    class="group relative rounded-2xl overflow-hidden aspect-[4/3] mb-6"
                >
                    <img
                        src="https://images.unsplash.com/photo-1573164713714-d95e436ab8d6?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80"
                        alt="Convention"
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                    <div
                        class="absolute top-4 left-4 bg-white/90 backdrop-blur px-3 py-1 rounded text-xs font-bold uppercase tracking-wide"
                    >
                        Bayernwerk
                    </div>
                </div>
                <h3
                    class="text-2xl font-bold text-brand-dark mb-2 group-hover:text-brand-blue transition-colors"
                >
                    Dialog Digital
                </h3>
                <p class="text-gray-600 line-clamp-2">
                    Konzeption und Umsetzung von
                    Online-Bürgerinformationsformaten während des
                    Leitungsumbaus.
                </p>
            </div>

        </div>
    </section>

    <!-- About / Locations Section -->
    <section id="agentur" class="py-24 bg-white">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid lg:grid-cols-2 gap-16 items-center">
                <div>
                    <h2 class="text-4xl font-bold text-brand-dark mb-6">
                        Präsenz, wo es zählt.
                    </h2>
                    <p class="text-lg text-gray-600 mb-8 leading-relaxed">
                        Seit über 30 Jahren ist Kaltwasser Kommunikation
                        inhabergeführt und unabhängig. Wir glauben an die
                        Kraft des persönlichen Gesprächs und die Reichweite
                        digitaler Kanäle.
                    </p>

                    <div class="space-y-6">
                        <div class="flex items-start gap-4">
                            <div
                                class="w-12 h-12 bg-blue-50 rounded-full flex items-center justify-center shrink-0 text-brand-blue"
                            >
                                <span class="font-serif font-bold text-xl"
                                    >N</span
                                >
                            </div>
                            <div>
                                <h4 class="font-bold text-gray-900">
                                    Nürnberg (HQ)
                                </h4>
                                <p class="text-sm text-gray-500">
                                    Zentrale an der Lorenzkirche
                                </p>
                            </div>
                        </div>
                        <div class="flex items-start gap-4">
                            <div
                                class="w-12 h-12 bg-blue-50 rounded-full flex items-center justify-center shrink-0 text-brand-blue"
                            >
                                <span class="font-serif font-bold text-xl"
                                    >M</span
                                >
                            </div>
                            <div>
                                <h4 class="font-bold text-gray-900">
                                    München
                                </h4>
                                <p class="text-sm text-gray-500">
                                    City-Büro Kaufingerstraße
                                </p>
                            </div>
                        </div>
                        <div class="flex items-start gap-4">
                            <div
                                class="w-12 h-12 bg-blue-50 rounded-full flex items-center justify-center shrink-0 text-brand-blue"
                            >
                                <span class="font-serif font-bold text-xl"
                                    >B</span
                                >
                            </div>
                            <div>
                                <h4 class="font-bold text-gray-900">
                                    Berlin
                                </h4>
                                <p class="text-sm text-gray-500">
                                    Hauptstadtbüro Charlottenburg
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="relative">
                    <div class="grid grid-cols-2 gap-4">
                        <img
