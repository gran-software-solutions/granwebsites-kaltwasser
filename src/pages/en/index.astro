        <script is:inline>
            document.addEventListener("DOMContentLoaded", () => {
                lucide.createIcons();

                // Logo Carousel
                const logoContainer = document.getElementById("logo-container");
                if (logoContainer) {
                    const prevButton = document.getElementById("prev-logo");
                    const nextButton = document.getElementById("next-logo");

                    const updateCarouselButtons = () => {
                        const atStart = logoContainer.scrollLeft < 10;
                        const atEnd =
                            logoContainer.scrollLeft +
                                logoContainer.clientWidth >=
                            logoContainer.scrollWidth - 10;
                        prevButton.disabled = atStart;
                        nextButton.disabled = atEnd;
                    };

                    nextButton.addEventListener("click", () => {
                        logoContainer.scrollBy({
                            left: logoContainer.clientWidth,
                            behavior: "smooth",
                        });
                    });

                    prevButton.addEventListener("click", () => {
                        logoContainer.scrollBy({
                            left: -logoContainer.clientWidth,
                            behavior: "smooth",
                        });
                    });

                    logoContainer.addEventListener(
                        "scroll",
                        updateCarouselButtons,
                        { passive: true },
                    );

                    // Initial check
                    updateCarouselButtons();
                }
            });

            // Mobile Menu Toggle
            function toggleMenu() {
                const menu = document.getElementById("mobile-menu");
                const isOpen = !menu.classList.contains("translate-x-full");

                if (isOpen) {
                    menu.classList.add("translate-x-full");
                } else {
                    menu.classList.remove("translate-x-full");
                }
            }

            // Navbar Scroll Effect
            window.addEventListener("scroll", () => {
                const navbar = document.getElementById("navbar");
                if (window.scrollY > 50) {
                    navbar.classList.add("shadow-md");
                } else {
                    navbar.classList.remove("shadow-md");
                }
            });
        </script>
