---
import "../../styles/global.css";

const logos = [
    "AEG-Logo.svg",
    "bayernkreativ-Logo.svg",
    "Bayernland-Logo.svg",
    "BFW-Nuernberg-Logo.svg",
    "bmfsfj-Logo.svg",
    "bmwi-Logo.svg",
    "Bosch-Logo.svg",
    "HP-Logo.svg",
    "Intel-Logo.svg",
    "Kyocera-Logo.svg",
    "Nokia-Logo.svg",
    "Philips-Logo.svg",
    "Samsung-Logo.svg",
];
---

<!doctype html>
<html lang="de" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Kaltwasser Kommunikation | Redesign Concept</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;1,600&display=swap"
            rel="stylesheet"
        />
        <script src="https://unpkg.com/lucide@latest" defer></script>
        <style>
            .glass-panel {
                background: rgba(255, 255, 255, 0.7);
                backdrop-filter: blur(12px);
                border: 1px solid rgba(255, 255, 255, 0.5);
            }
            .bento-card {
                transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            }
            .bento-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 10px 40px -10px rgba(0, 71, 171, 0.15);
            }
            .text-gradient {
                background: linear-gradient(135deg, #0f172a 0%, #0047ab 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }
            /* Custom Scrollbar */
            ::-webkit-scrollbar {
                width: 8px;
            }
            ::-webkit-scrollbar-track {
                background: #f1f1f1;
            }
            ::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 4px;
            }
            ::-webkit-scrollbar-thumb:hover {
                background: #94a3b8;
            }
            .scrollbar-hide::-webkit-scrollbar {
                display: none;
            }
            .scrollbar-hide {
                -ms-overflow-style: none;
                scrollbar-width: none;
            }
        </style>
    </head>
    <body
        class="bg-slate-50 text-slate-900 antialiased selection:bg-brand-blue selection:text-white"
    >
        <!-- Mobile Navigation Overlay (Hidden by default) -->
        <div
            id="mobile-menu"
            class="fixed inset-0 z-50 bg-white transform translate-x-full transition-transform duration-300 lg:hidden flex flex-col pt-24 px-8"
        >
            <a
                href="#kompetenzen"
                class="text-2xl font-medium py-4 border-b border-gray-100"
                onclick="toggleMenu()">Kompetenzen</a
            >
            <a
                href="#projekte"
                class="text-2xl font-medium py-4 border-b border-gray-100"
                onclick="toggleMenu()">Projekte</a
            >
            <a
                href="#agentur"
                class="text-2xl font-medium py-4 border-b border-gray-100"
                onclick="toggleMenu()">Agentur</a
            >
            <a
                href="#karriere"
                class="text-2xl font-medium py-4 border-b border-gray-100"
                onclick="toggleMenu()">Karriere</a
            >
            <a
                href="#kontakt"
                class="mt-8 bg-brand-blue text-white text-center py-4 rounded-full text-xl font-medium"
                onclick="toggleMenu()">Kontakt</a
            >
        </div>

        <!-- Navigation -->
        <nav
            class="fixed w-full z-40 top-0 transition-all duration-300"
            id="navbar"
        >
            <div
                class="glass-panel mx-auto px-6 py-4 lg:px-12 border-b border-gray-200/50"
            >
                <div
                    class="flex items-center justify-between max-w-7xl mx-auto"
                >
                    <!-- Logo Area -->
                    <a href="#" class="flex items-center gap-2 group">
                        <div
                            class="w-8 h-8 bg-brand-blue rounded-tr-xl rounded-bl-xl group-hover:rotate-12 transition-transform duration-300"
                        >
                        </div>
                        <span
                            class="font-bold text-xl tracking-tight text-white"
                            >Kaltwasser <span class="font-light text-gray-300"
                                >Kommunikation</span
                            ></span
                        >
                    </a>

                    <!-- Desktop Menu -->
                    <div
                        class="hidden lg:flex items-center gap-6 font-medium text-sm text-gray-600"
                    >
                        <a
                            href="#kompetenzen"
                            class="hover:text-brand-blue transition-colors"
                            >Kompetenzen</a
                        >
                        <a
                            href="#projekte"
                            class="hover:text-brand-blue transition-colors"
                            >Projekte</a
                        >
                        <a
                            href="#agentur"
                            class="hover:text-brand-blue transition-colors"
                            >Agentur</a
                        >
                        <a
                            href="#karriere"
                            class="hover:text-brand-blue transition-colors"
                            >Karriere</a
                        >

                        <div
                            class="flex items-center gap-2 text-sm font-medium ml-4"
                        >
                            <a href="/de/" class="text-brand-dark font-semibold"
                                >DE</a
                            >
                            <span class="text-gray-300">/</span>
                            <a
                                href="/en/"
                                class="text-gray-500 hover:text-brand-dark font-normal"
                                >EN</a
                            >
                        </div>

                        <a
                            href="#kontakt"
                            class="px-5 py-2.5 bg-brand-dark text-white rounded-full hover:bg-brand-blue transition-colors text-sm font-semibold"
                        >
                            Kontakt aufnehmen
                        </a>
                    </div>

                    <!-- Mobile Hamburger -->
                    <button
                        class="lg:hidden p-2 text-gray-600"
                        onclick="toggleMenu()"
                    >
                        <i data-lucide="menu" class="w-6 h-6"></i>
                    </button>
                </div>
            </div>
        </nav>

        <!-- Hero Section -->
        <header
            class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 px-6 overflow-hidden"
        >
            <!-- Background Elements -->
            <div
                class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-l from-blue-50 to-transparent -z-10"
            >
            </div>
            <div
                class="absolute top-20 right-20 w-64 h-64 bg-blue-100 rounded-full blur-3xl opacity-50 -z-10 animate-pulse"
            >
            </div>

            <div
                class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-12 items-center"
            >
                <div class="space-y-8">
                    <div
                        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-brand-blue text-xs font-semibold uppercase tracking-wider"
                    >
                        <span
                            class="w-2 h-2 rounded-full bg-brand-blue animate-ping"
                        ></span>
                        Seit 1990
                    </div>
                    <h1
                        class="text-5xl lg:text-7xl font-bold leading-[1.1] text-brand-dark tracking-tight"
                    >
                        Kommunikation,<br />
                        <span class="text-brand-blue serif italic pr-2"
                            >die bewegt.</span
                        >
                    </h1>
                    <p class="text-lg text-gray-600 max-w-xl leading-relaxed">
                        Wir gestalten Wandel. Von strategischer PR über
                        Bürgerdialog bis zur Krisenkommunikation. Aus Nürnberg,
                        München und Berlin für ganz Deutschland.
                    </p>

                    <div class="flex flex-col sm:flex-row gap-4 pt-4">
                        <a
                            href="#projekte"
                            class="inline-flex justify-center items-center px-8 py-4 bg-brand-blue text-white rounded-full font-medium hover:bg-blue-700 transition-all hover:shadow-lg hover:shadow-blue-200 group"
                        >
                            Unsere Cases
                            <i
                                data-lucide="arrow-right"
                                class="ml-2 w-4 h-4 group-hover:translate-x-1 transition-transform"
                            ></i>
                        </a>
                        <a
                            href="#kompetenzen"
                            class="inline-flex justify-center items-center px-8 py-4 bg-white border border-gray-200 text-gray-700 rounded-full font-medium hover:bg-gray-50 transition-colors"
                        >
                            Leistungen ansehen
                        </a>
                    </div>
                </div>

                <!-- Abstract Visual / Stats -->
                <div class="relative hidden lg:block col-span-1 h-[600px]">
                    <div
                        class="w-full h-full bg-slate-200 rounded-2xl overflow-hidden shadow-2xl rotate-3 hover:rotate-0 transition-all duration-700"
                    >
                        <img
                            src="/img/Kaltwasser-Kommunikation-Agentur-bl.jpg"
                            alt="Collage of German landmarks: Berlin, Nuremberg, and Munich"
                            class="w-full h-full object-cover"
                        />
                        <div
                            class="absolute inset-0 bg-gradient-to-t from-brand-dark/20 to-transparent"
                        >
                        </div>
                    </div>
                    <!-- Floating Stat Card -->
                    <div
                        class="absolute bottom-20 left-10 bg-white p-6 rounded-xl shadow-xl max-w-[200px] animate-bounce-slow"
                    >
                        <div class="flex items-center gap-3 mb-2">
                            <div
                                class="p-2 bg-green-100 rounded-lg text-green-600"
                            >
                                <i data-lucide="trending-up" class="w-5 h-5"
                                ></i>
                            </div>
                            <span class="text-3xl font-bold text-gray-900"
                                >35+</span
                            >
                        </div>
                        <p class="text-sm text-gray-600 font-medium">
                            Jahre Erfahrung im Markt
                        </p>
                    </div>
                </div>
            </div>
        </header>

        <!-- Logo Carousel Section -->
        <section class="py-12 bg-white border-b border-gray-100">
            <div class="max-w-7xl mx-auto px-6 mb-8 text-center">
                <p
                    class="text-xs font-bold text-gray-400 uppercase tracking-[0.2em]"
                >
                    Vertrauen von führenden Unternehmen & Institutionen
                </p>
            </div>

            <div id="logo-carousel" class="relative max-w-5xl mx-auto">
                <div
                    id="logo-container"
                    class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth scrollbar-hide"
                >
                    <div
                        class="flex-shrink-0 w-full flex items-center justify-center gap-16 snap-center p-4"
                    >
                        {
                            logos
                                .slice(0, 4)
                                .map((logo) => (
                                    <img
                                        src={`/img/${logo}`}
                                        class="h-32 w-auto flex-shrink-0"
                                        alt={logo.replace(".svg", "")}
                                    />
                                ))
                        }
                    </div>

                    <div
                        class="flex-shrink-0 w-full flex items-center justify-center gap-16 snap-center p-4"
                    >
                        {
                            logos
                                .slice(4, 8)
                                .map((logo) => (
                                    <img
                                        src={`/img/${logo}`}
                                        class="h-32 w-auto flex-shrink-0"
                                        alt={logo.replace(".svg", "")}
                                    />
                                ))
                        }
                    </div>

                    <div
                        class="flex-shrink-0 w-full flex items-center justify-center gap-16 snap-center p-4"
                    >
                        {
                            logos
                                .slice(8, 13)
                                .map((logo) => (
                                    <img
                                        src={`/img/${logo}`}
                                        class="h-32 w-auto flex-shrink-0"
                                        alt={logo.replace(".svg", "")}
                                    />
                                ))
                        }
                    </div>
                </div>

                <button
                    id="prev-logo"
                    class="absolute top-1/2 left-0 -translate-y-1/2 bg-white/50 backdrop-blur-sm p-2 rounded-full shadow-md hover:bg-white transition-all disabled:opacity-0 disabled:cursor-not-allowed"
                >
                    <i data-lucide="chevron-left" class="w-6 h-6 text-slate-700"
                    ></i>
                </button>
                <button
                    id="next-logo"
                    class="absolute top-1/2 right-0 -translate-y-1/2 bg-white/50 backdrop-blur-sm p-2 rounded-full shadow-md hover:bg-white transition-all disabled:opacity-0 disabled:cursor-not-allowed"
                >
                    <i
                        data-lucide="chevron-right"
                        class="w-6 h-6 text-slate-700"></i>
                </button>
            </div>
        </section>

        <!-- Services Bento Grid -->
        <section id="kompetenzen" class="py-24 px-6 bg-white">
            <div class="max-w-7xl mx-auto">
                <div class="text-center max-w-2xl mx-auto mb-16">
                    <h2
                        class="text-3xl lg:text-4xl font-bold text-brand-dark mb-4"
                    >
                        Kompetenz im Quadrat
                    </h2>
                    <p class="text-gray-600 text-lg">
                        Unser integrierter Ansatz verbindet klassische PR mit
                        modernen Dialogformaten.
                    </p>
                </div>

                <div
                    class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6 auto-rows-[250px]"
                >
                    <!-- Main Service Card (Large) -->
                    <div
                        class="bento-card md:col-span-2 md:row-span-2 bg-slate-900 rounded-3xl p-10 relative overflow-hidden group cursor-pointer"
                    >
                        <div
                            class="absolute top-0 right-0 p-10 opacity-10 group-hover:opacity-20 transition-opacity"
                        >
                            <i data-lucide="users" class="w-48 h-48 text-white"
                            ></i>
                        </div>
                        <div
                            class="relative z-10 h-full flex flex-col justify-between"
                        >
                            <div>
                                <div
                                    class="w-12 h-12 bg-blue-600 rounded-xl flex items-center justify-center mb-6"
                                >
                                    <i
                                        data-lucide="message-circle"
                                        class="text-white w-6 h-6"></i>
                                </div>
                                <h3 class="text-3xl font-bold text-white mb-4">
                                    Bürgerkommunikation
                                </h3>
                                <p
                                    class="text-gray-400 text-lg leading-relaxed"
                                >
                                    Akzeptanz schaffen durch Dialog. Wir
                                    begleiten Infrastrukturprojekte, Bauvorhaben
                                    und die Energiewende mit transparenter
                                    Kommunikation auf Augenhöhe.
                                </p>
                            </div>
                            <span
                                class="text-blue-400 font-medium flex items-center gap-2 group-hover:translate-x-2 transition-transform"
                            >
                                Mehr erfahren <i
                                    data-lucide="arrow-right"
                                    class="w-4 h-4"></i>
                            </span>
                        </div>
                    </div>

                    <!-- Service 2 -->
                    <div
                        class="bento-card bg-blue-50 rounded-3xl p-8 flex flex-col justify-between group hover:bg-blue-100 cursor-pointer"
                    >
                        <div
                            class="w-10 h-10 bg-white rounded-full flex items-center justify-center shadow-sm text-brand-blue mb-4"
                        >
                            <i data-lucide="building-2" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-gray-900 mb-2">
                                Corporate Comms
                            </h3>
                            <p class="text-sm text-gray-600">
                                Reputation stärken, intern wie extern.
                            </p>
                        </div>
                    </div>

                    <!-- Service 3 -->
                    <div
                        class="bento-card bg-slate-50 rounded-3xl p-8 flex flex-col justify-between group hover:bg-slate-100 cursor-pointer"
                    >
                        <div
                            class="w-10 h-10 bg-white rounded-full flex items-center justify-center shadow-sm text-brand-blue mb-4"
                        >
                            <i data-lucide="shield-alert" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-gray-900 mb-2">
                                Krisen-PR
                            </h3>
                            <p class="text-sm text-gray-600">
                                Sicher navigieren, wenn es stürmt. 24/7 Support.
                            </p>
                        </div>
                    </div>

                    <!-- Service 4 -->
                    <div
                        class="bento-card md:col-span-2 bg-gradient-to-br from-brand-blue to-blue-600 rounded-3xl p-8 relative overflow-hidden group cursor-pointer"
                    >
                        <div
                            class="absolute -right-10 -bottom-10 opacity-20 rotate-12"
                        >
                            <i
                                data-lucide="share-2"
                                class="w-40 h-40 text-white"></i>
                        </div>
                        <div
                            class="relative z-10 flex flex-col h-full justify-between"
                        >
                            <div
                                class="w-10 h-10 bg-white/20 backdrop-blur-md rounded-full flex items-center justify-center text-white mb-4"
                            >
                                <i data-lucide="smartphone" class="w-5 h-5"></i>
                            </div>
                            <div>
                                <h3 class="text-2xl font-bold text-white mb-2">
                                    Social Media & Digital
                                </h3>
                                <p class="text-blue-100 max-w-sm">
                                    Strategisches Storytelling für LinkedIn,
                                    Instagram & Co. Vom Content-Plan bis zum
                                    Community Management.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Service 5 -->
                    <div
                        class="bento-card bg-slate-50 rounded-3xl p-8 flex flex-col justify-between group hover:bg-slate-100 cursor-pointer"
                    >
                        <div
                            class="w-10 h-10 bg-white rounded-full flex items-center justify-center shadow-sm text-brand-blue mb-4"
                        >
                            <i data-lucide="megaphone" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-gray-900 mb-2">
                                Public Affairs
                            </h3>
                            <p class="text-sm text-gray-600">
                                Brücken bauen zwischen Wirtschaft und Politik.
                            </p>
                        </div>
                    </div>
                    <!-- Service 6 -->
                    <div
                        class="bento-card bg-slate-50 rounded-3xl p-8 flex flex-col justify-between group hover:bg-slate-100 cursor-pointer"
                    >
                        <div
                            class="w-10 h-10 bg-white rounded-full flex items-center justify-center shadow-sm text-brand-blue mb-4"
                        >
                            <i data-lucide="refresh-cw" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-gray-900 mb-2">
                                Change
                            </h3>
                            <p class="text-sm text-gray-600">
                                Veränderungsprozesse kommunikativ begleiten.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Featured Projects (Horizontal Scroll Concept) -->
        <section id="projekte" class="py-24 bg-slate-50 overflow-hidden">
            <div
                class="max-w-7xl mx-auto px-6 mb-12 flex items-end justify-between"
            >
                <div>
                    <span
                        class="text-brand-blue font-semibold uppercase tracking-wider text-sm"
                        >Case Studies</span
                    >
                    <h2 class="text-4xl font-bold text-brand-dark mt-2">
                        Aktuelle Arbeiten
                    </h2>
                </div>
                <div class="hidden md:flex gap-2">
                    <button
                        class="w-12 h-12 rounded-full border border-gray-300 flex items-center justify-center hover:bg-white hover:shadow-md transition-all"
                        ><i data-lucide="arrow-left" class="w-5 h-5"
                        ></i></button
                    >
                    <button
                        class="w-12 h-12 rounded-full border border-gray-800 bg-brand-dark text-white flex items-center justify-center hover:bg-gray-700 transition-all"
                        ><i data-lucide="arrow-right" class="w-5 h-5"
                        ></i></button
                    >
                </div>
            </div>

            <div
                class="flex overflow-x-auto gap-8 px-6 pb-12 snap-x max-w-7xl mx-auto scrollbar-hide"
            >
                <!-- Project 1 -->
                <div class="min-w-[85vw] md:min-w-[500px] snap-center">
                    <div
                        class="group relative rounded-2xl overflow-hidden aspect-[4/3] mb-6"
                    >
                        <img
                            src="https://images.unsplash.com/photo-1473341304170-971dccb5ac1e?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80"
                            alt="Energy Grid"
                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                        />
                        <div
                            class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-colors"
                        >
                        </div>
                        <div
                            class="absolute top-4 left-4 bg-white/90 backdrop-blur px-3 py-1 rounded text-xs font-bold uppercase tracking-wide"
                        >
                            50Hertz
                        </div>
                    </div>
                    <h3
                        class="text-2xl font-bold text-brand-dark mb-2 group-hover:text-brand-blue transition-colors"
                    >
                        Klarheit im Netzausbau
                    </h3>
                    <p class="text-gray-600 line-clamp-2">
                        Strategische Beratung und Konfliktmoderation für den
                        Übertragungsnetzbetreiber. Transparenz schafft
                        Akzeptanz.
                    </p>
                </div>

                <!-- Project 2 -->
                <div class="min-w-[85vw] md:min-w-[500px] snap-center">
                    <div
                        class="group relative rounded-2xl overflow-hidden aspect-[4/3] mb-6"
                    >
                        <img
                            src="https://images.unsplash.com/photo-1497366216548-37526070297c?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80"
                            alt="Modern wooden skyscraper"
                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                        />
                        <div
                            class="absolute top-4 left-4 bg-white/90 backdrop-blur px-3 py-1 rounded text-xs font-bold uppercase tracking-wide"
                        >
                            UmweltBank
                        </div>
                    </div>
                    <h3
                        class="text-2xl font-bold text-brand-dark mb-2 group-hover:text-brand-blue transition-colors"
                    >
                        Ein Holzhochhaus als PR-Leuchtturm
                    </h3>
                    <p class="text-gray-600 line-clamp-2">
                        Bundesweite Medienpräsenz für den nachhaltigen
                        Firmensitz. Storytelling, das die Marke stärkt.
                    </p>
                </div>

                <!-- Project 3 -->
                <div class="min-w-[85vw] md:min-w-[500px] snap-center">
                    <div
                        class="group relative rounded-2xl overflow-hidden aspect-[4/3] mb-6"
                    >
                        <img
                            src="https://images.unsplash.com/photo-1573164713714-d95e436ab8d6?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80"
                            alt="Convention"
                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                        />
                        <div
                            class="absolute top-4 left-4 bg-white/90 backdrop-blur px-3 py-1 rounded text-xs font-bold uppercase tracking-wide"
                        >
                            Bayernwerk
                        </div>
                    </div>
                    <h3
                        class="text-2xl font-bold text-brand-dark mb-2 group-hover:text-brand-blue transition-colors"
                    >
                        Dialog Digital
                    </h3>
                    <p class="text-gray-600 line-clamp-2">
                        Konzeption und Umsetzung von
                        Online-Bürgerinformationsformaten während des
                        Leitungsumbaus.
                    </p>
                </div>
            </div>
        </section>

        <!-- About / Locations Section -->
        <section id="agentur" class="py-24 bg-white">
            <div class="max-w-7xl mx-auto px-6">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div>
                        <h2 class="text-4xl font-bold text-brand-dark mb-6">
                            Präsenz, wo es zählt.
                        </h2>
                        <p class="text-lg text-gray-600 mb-8 leading-relaxed">
                            Seit über 30 Jahren ist Kaltwasser Kommunikation
                            inhabergeführt und unabhängig. Wir glauben an die
                            Kraft des persönlichen Gesprächs und die Reichweite
                            digitaler Kanäle.
                        </p>

                        <div class="space-y-6">
                            <div class="flex items-start gap-4">
                                <div
